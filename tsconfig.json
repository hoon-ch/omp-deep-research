{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2024"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["index.ts", "src/**/*.ts", "tests/**/*.ts", "bench/**/*.ts"]
}
